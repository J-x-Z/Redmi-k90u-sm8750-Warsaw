#!/system/bin/sh

VERSION="0.1.0"
STATE_ROOT="${JXZ_BORE_STATE_ROOT:-/data/local/tmp/jxz-bore-like}"
PROFILE_STATE="$STATE_ROOT/profile.state"
PROFILE_MODE="$STATE_ROOT/profile.mode"
AUTOSTART_ROOT="/data/adb/jxz-bore-like"
AUTOSTART_FILE="$AUTOSTART_ROOT/autostart"

TOP_APP_MIN="/dev/cpuctl/top-app/cpu.uclamp.min"
TOP_APP_LATENCY="/dev/cpuctl/top-app/cpu.uclamp.latency_sensitive"
FOREGROUND_WINDOW_MIN="/dev/cpuctl/foreground_window/cpu.uclamp.min"
FOREGROUND_WINDOW_LATENCY="/dev/cpuctl/foreground_window/cpu.uclamp.latency_sensitive"

die() {
    echo "jxz-bore: $*" >&2
    exit 1
}

require_root() {
    [ "$(id -u)" = "0" ] || die "this operation requires root"
}

valid_profile() {
    case "$1" in
        latency|balanced|burst) return 0 ;;
        *) return 1 ;;
    esac
}

boot_id() {
    cat /proc/sys/kernel/random/boot_id 2>/dev/null
}

state_boot_id() {
    sed -n 's/^# boot_id=//p' "$PROFILE_STATE" 2>/dev/null | head -n 1
}

state_is_current() {
    [ -s "$PROFILE_STATE" ] || return 1
    [ "$(state_boot_id)" = "$(boot_id)" ]
}

prepare_state_root() {
    mkdir -p "$STATE_ROOT" || die "cannot create $STATE_ROOT"
    chmod 0700 "$STATE_ROOT" 2>/dev/null || true
}

read_knob() {
    [ -r "$1" ] || die "missing scheduler knob: $1"
    cat "$1" || die "cannot read scheduler knob: $1"
}

write_knob() {
    path="$1"
    value="$2"
    [ -e "$path" ] || die "missing scheduler knob: $path"
    printf '%s\n' "$value" > "$path" || die "cannot write $path"
    [ -r "$path" ] || die "cannot verify $path"
}

snapshot_profile() {
    prepare_state_root
    temporary="$PROFILE_STATE.new.$$"
    {
        echo "# jxz-bore-like-state-v1"
        echo "# boot_id=$(boot_id)"
        echo "# kernel=$(uname -r)"
        for path in \
            "$TOP_APP_MIN" \
            "$TOP_APP_LATENCY" \
            "$FOREGROUND_WINDOW_MIN" \
            "$FOREGROUND_WINDOW_LATENCY"
        do
            printf '%s|%s\n' "$path" "$(read_knob "$path")"
        done
    } > "$temporary" || die "cannot create scheduler snapshot"
    mv "$temporary" "$PROFILE_STATE" || die "cannot commit scheduler snapshot"
}

restore_values() {
    [ -s "$PROFILE_STATE" ] || return 0
    while IFS='|' read -r path value
    do
        case "$path" in
            \#*|'') continue ;;
            /dev/cpuctl/*) write_knob "$path" "$value" ;;
            *) die "refusing unexpected state path: $path" ;;
        esac
    done < "$PROFILE_STATE"
}

profile_enable() {
    require_root
    mode="${1:-balanced}"
    valid_profile "$mode" || die "unknown profile: $mode"

    prepare_state_root
    if [ -s "$PROFILE_STATE" ] && ! state_is_current; then
        rm -f "$PROFILE_STATE" "$PROFILE_MODE"
    fi
    if state_is_current; then
        restore_values
    else
        snapshot_profile
    fi

    case "$mode" in
        latency)
            write_knob "$TOP_APP_LATENCY" 1
            write_knob "$FOREGROUND_WINDOW_LATENCY" 1
            ;;
        balanced)
            write_knob "$TOP_APP_MIN" 6.25
            write_knob "$FOREGROUND_WINDOW_MIN" 3.12
            write_knob "$TOP_APP_LATENCY" 1
            write_knob "$FOREGROUND_WINDOW_LATENCY" 1
            ;;
        burst)
            write_knob "$TOP_APP_MIN" 12.50
            write_knob "$FOREGROUND_WINDOW_MIN" 6.25
            write_knob "$TOP_APP_LATENCY" 1
            write_knob "$FOREGROUND_WINDOW_LATENCY" 1
            ;;
    esac

    printf '%s\n' "$mode" > "$PROFILE_MODE" || {
        restore_values
        die "cannot record active profile"
    }
    echo "J-x-Z BORE-like profile enabled: $mode"
}

profile_disable() {
    require_root
    if [ ! -s "$PROFILE_STATE" ]; then
        rm -f "$PROFILE_MODE"
        echo "J-x-Z BORE-like profile is already disabled"
        return 0
    fi
    if ! state_is_current; then
        rm -f "$PROFILE_STATE" "$PROFILE_MODE"
        echo "Discarded stale state from an earlier boot; current boot was unchanged"
        return 0
    fi
    restore_values
    rm -f "$PROFILE_STATE" "$PROFILE_MODE"
    echo "J-x-Z BORE-like profile disabled; scheduler baseline restored"
}

profile_status() {
    echo "name=J-x-Z BORE-like"
    echo "version=$VERSION"
    echo "implementation=userspace-uclamp"
    echo "kernel=$(uname -r)"
    echo "sched_energy_aware=$(cat /proc/sys/kernel/sched_energy_aware 2>/dev/null || echo unavailable)"

    if state_is_current; then
        echo "profile_active=yes"
        echo "profile=$(cat "$PROFILE_MODE" 2>/dev/null || echo unknown)"
    elif [ -s "$PROFILE_STATE" ]; then
        echo "profile_active=stale-state"
    else
        echo "profile_active=no"
    fi

    for path in \
        "$TOP_APP_MIN" \
        "$TOP_APP_LATENCY" \
        "$FOREGROUND_WINDOW_MIN" \
        "$FOREGROUND_WINDOW_LATENCY"
    do
        if [ -r "$path" ]; then
            echo "$path=$(cat "$path")"
        else
            echo "$path=unavailable"
        fi
    done

    for policy in /sys/devices/system/cpu/cpufreq/policy*
    do
        [ -d "$policy" ] || continue
        echo "$policy/governor=$(cat "$policy/scaling_governor" 2>/dev/null || echo unavailable)"
        echo "$policy/walt_boost=$(cat "$policy/walt/boost" 2>/dev/null || echo unavailable)"
    done

    if [ -r "$AUTOSTART_FILE" ]; then
        echo "autostart=$(cat "$AUTOSTART_FILE")"
    else
        echo "autostart=off"
    fi
}

selftest() {
    require_root
    [ "$(cat /proc/sys/kernel/sched_energy_aware 2>/dev/null)" = "1" ] || die "EAS is not enabled"
    command -v uclampset >/dev/null 2>&1 || die "uclampset is unavailable"

    for path in \
        "$TOP_APP_MIN" \
        "$TOP_APP_LATENCY" \
        "$FOREGROUND_WINDOW_MIN" \
        "$FOREGROUND_WINDOW_LATENCY"
    do
        value="$(read_knob "$path")"
        write_knob "$path" "$value"
    done

    for policy in /sys/devices/system/cpu/cpufreq/policy*
    do
        [ -d "$policy" ] || continue
        governor="$(cat "$policy/scaling_governor" 2>/dev/null)"
        [ "$governor" = "walt" ] || die "unexpected governor on $policy: $governor"
    done
    echo "PASS: EAS, WALT and all targeted uclamp controls are available"
}

profile_pulse() {
    require_root
    mode="${1:-balanced}"
    seconds="${2:-10}"
    valid_profile "$mode" || die "unknown profile: $mode"
    case "$seconds" in
        ''|*[!0-9]*) die "pulse duration must be an integer" ;;
    esac
    [ "$seconds" -ge 1 ] && [ "$seconds" -le 300 ] || die "pulse duration must be 1..300 seconds"

    profile_enable "$mode"
    trap 'profile_disable >/dev/null 2>&1' INT TERM EXIT
    sleep "$seconds"
    profile_disable
    trap - INT TERM EXIT
}

run_burst() {
    require_root
    minimum=128
    if [ "$1" = "--min" ]; then
        [ "$#" -ge 3 ] || die "run --min requires a value and command"
        minimum="$2"
        shift 2
    fi
    case "$minimum" in
        ''|*[!0-9]*) die "uclamp minimum must be an integer" ;;
    esac
    [ "$minimum" -ge 0 ] && [ "$minimum" -le 1024 ] || die "uclamp minimum must be 0..1024"
    [ "$#" -gt 0 ] || die "run requires a command"
    command -v uclampset >/dev/null 2>&1 || die "uclampset is unavailable"
    exec uclampset -m "$minimum" -M 1024 -- "$@"
}

autostart() {
    require_root
    action="${1:-status}"
    case "$action" in
        status)
            if [ -r "$AUTOSTART_FILE" ]; then
                echo "autostart=$(cat "$AUTOSTART_FILE")"
            else
                echo "autostart=off"
            fi
            ;;
        off)
            rm -f "$AUTOSTART_FILE"
            echo "J-x-Z BORE-like autostart disabled"
            ;;
        latency|balanced|burst)
            mkdir -p "$AUTOSTART_ROOT" || die "cannot create $AUTOSTART_ROOT"
            chmod 0700 "$AUTOSTART_ROOT" 2>/dev/null || true
            printf '%s\n' "$action" > "$AUTOSTART_FILE" || die "cannot write autostart profile"
            chmod 0600 "$AUTOSTART_FILE" 2>/dev/null || true
            echo "J-x-Z BORE-like autostart set to: $action"
            ;;
        *) die "autostart expects off, latency, balanced or burst" ;;
    esac
}

usage() {
    cat <<'EOF'
J-x-Z BORE-like: ABI-preserving EAS/WALT companion

Usage:
  jxz-bore status
  jxz-bore selftest
  jxz-bore enable [latency|balanced|burst]
  jxz-bore disable
  jxz-bore pulse [latency|balanced|burst] [1..300]
  jxz-bore run [--min 0..1024] COMMAND [ARG...]
  jxz-bore autostart [status|off|latency|balanced|burst]

This is a reversible userspace uclamp profile, not the upstream BORE patch.
It does not modify scheduler structs, WALT tunables or Xiaomi module parameters.
EOF
}

command_name="${1:-help}"
[ "$#" -eq 0 ] || shift

case "$command_name" in
    status) profile_status "$@" ;;
    selftest) selftest "$@" ;;
    enable) profile_enable "$@" ;;
    disable) profile_disable "$@" ;;
    pulse) profile_pulse "$@" ;;
    run) run_burst "$@" ;;
    autostart) autostart "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "unknown command: $command_name" ;;
esac
